{
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Firebase": {
    "ProjectId": "daybook-53705",
    "FirestoreEnabled": true
  },
  "Storage": {
    "Provider": "NeonS3",
    "Endpoint": "",
    "Region": "ap-southeast-1",
    "Bucket": "daybook-audio"
  },
  "Stt": {
    "Provider": "Groq",
    "Endpoint": "https://api.groq.com/openai/v1/audio/transcriptions",
    "PrimaryModel": "whisper-large-v3",
    "FallbackModel": "whisper-large-v3-turbo",
    "TimeoutMinutes": 10,
    "MaxUploadMegabytes": 24
  },
  "Gemini": {
    "Model": "gemini-2.5-flash",
    "TimeoutMinutes": 5
  },
  "Worker": {
    "PollIntervalSeconds": 5,
    "MaxJobAttempts": 3,
    "MaxConcurrentJobs": 1,
    "TempDirectory": "./data/tmp",
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe"
  }
}
